# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=production

# Database (Neon Postgres connection string)
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Auth — use long random strings; the two must differ
JWT_SECRET=change-me-long-random-string
JWT_REFRESH_SECRET=change-me-another-long-random-string

# CORS — comma-separated browser origins allowed to call the API / sockets.
# Requests with no Origin header (mobile app, curl) are always allowed.
# Default when unset: http://localhost:5173,http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-web-app.example.com

# SMTP (verification codes, temporary passwords)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=change-me

# Web client URL (currently not read by the code)
CLIENT_URL=https://your-web-app.example.com

# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Identity verification (optional): folder containing face-api weight files
FACE_MODELS_PATH=./face-models

# Gemini translation (POST /api/translation/gemini). Leave GEMINI_API_KEY empty
# to disable the endpoint (it then returns 503). The client-sent model is ignored.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
